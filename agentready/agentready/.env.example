# Optional. Without this the pipeline runs in deterministic mock mode and the
# demo still works end to end.
OPENAI_API_KEY=sk-...

# Model. gpt-4o-mini is the safe default: cheap, fast, supports strict
# structured outputs. Swap to gpt-4o or gpt-4.1 if you have budget and want
# better Tier 3/4 reasoning.
AGENTREADY_MODEL=gpt-4o-mini

# Only set this if your API is an OpenAI-COMPATIBLE proxy rather than OpenAI
# itself (school-issued keys, Azure gateways, OpenRouter, a local vLLM server).
# Leave it commented out for real OpenAI.
# OPENAI_BASE_URL=https://your-proxy.example.com/v1
